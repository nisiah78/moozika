#!/usr/bin/env bash
#
# Filet de sécurité pour les commits faits À LA MAIN (hors Claude Code).
# Budget : < 5 s. Il ne lance NI tests NI lint Python/TS — un hook lent se
# contourne au `--no-verify`, ce qui le rend inutile. La porte complète (tests +
# score) est le travail de `make gate` / du skill /pr-check.
#
# EXCEPTION PHP : ce hook DÉLÈGUE à GrumPHP (apps/api/grumphp.yml) dès qu'un .php
# est indexé. Raison : GrumPHP installe son propre .git/hooks/pre-commit, que
# `core.hooksPath=scripts/hooks` rendrait muet — le déléguer ici évite de
# désactiver silencieusement phpstan/phpcsfixer/jsonlint/yamllint.
# Coût mesuré : ~2,6 s (phpstan niveau 8) quand du PHP change, 0,03 s sinon.
#
# Activation (une fois par clone) :   make hooks
# Contournement volontaire :          git commit --no-verify

set -uo pipefail

RED='\033[0;31m'; YEL='\033[0;33m'; NC='\033[0m'
fail=0

staged() { git diff --cached --name-only --diff-filter=ACMR; }

# --- 1. Index vide --------------------------------------------------------- #
if [ -z "$(staged)" ]; then
    printf "${RED}✗ index vide${NC} — rien à committer (utilise 'git add <fichiers>').\n"
    exit 1
fi

# --- 2. Artefacts qui ne doivent jamais entrer dans un commit -------------- #
while IFS= read -r f; do
    case "$(basename "$f")" in
        _debug_*.ndjson|*.orig|*.rej|*.pyc|*.log)
            printf "${RED}✗ artefact interdit indexé${NC} : %s\n" "$f"
            fail=1
            ;;
    esac
done < <(staged)

# --- 3. Syntaxe Python ----------------------------------------------------- #
# ast.parse et non py_compile : py_compile écrit un .pyc, et le __pycache__ de
# apps/omr-service/app appartient à root (ancien run Docker) → Permission denied.
py=$(staged | grep -E '\.py$' || true)
if [ -n "$py" ]; then
    # shellcheck disable=SC2086
    if ! python3 scripts/quality/syntax_check.py $py 2>/tmp/moozika-hook-py.err; then
        printf "${RED}✗ syntaxe python${NC}\n"
        sed 's/^/    /' /tmp/moozika-hook-py.err
        fail=1
    fi
fi

# --- 4. PHP : délégation à GrumPHP ----------------------------------------- #
php=$(staged | grep -E '\.php$' || true)
if [ -n "$php" ]; then
    if [ -x apps/api/vendor/bin/grumphp ]; then
        # Même protocole que le hook natif de GrumPHP : le diff indexé arrive sur
        # stdin, et GRUMPHP_GIT_WORKING_DIR pointe la racine du monorepo.
        GRUMPHP_GIT_WORKING_DIR="$(git rev-parse --show-toplevel)"
        export GRUMPHP_GIT_WORKING_DIR
        DIFF=$(git -c diff.mnemonicprefix=false -c diff.noprefix=false --no-pager \
               diff --raw -r -p -m -M --full-index --no-color --staged | cat)
        if ! (cd apps/api && printf "%s\n" "${DIFF}" \
              | vendor/bin/grumphp git:pre-commit --skip-success-output); then
            printf "${RED}✗ GrumPHP${NC} (phpstan / phpcsfixer / jsonlint / yamllint)\n"
            fail=1
        fi
    elif command -v php >/dev/null 2>&1; then
        # Repli si le vendor n'est pas installé : au moins la syntaxe.
        printf "${YEL}·${NC} GrumPHP absent (composer install) — repli sur php -l\n"
        while IFS= read -r f; do
            [ -f "$f" ] || continue
            if ! php -l "$f" >/tmp/moozika-hook-php.err 2>&1; then
                printf "${RED}✗ php -l${NC} %s\n" "$f"
                sed 's/^/    /' /tmp/moozika-hook-php.err
                fail=1
            fi
        done <<< "$php"
    fi
fi

# --- 5. Rappel : le hook ne remplace pas la porte -------------------------- #
if [ "$fail" -eq 0 ]; then
    if [ -n "$php" ]; then
        scope="syntaxe + GrumPHP (PHP)"
    else
        scope="syntaxe seule"
    fi
    printf "${YEL}·${NC} hook OK (%s). Tests et score : ${YEL}make gate${NC} ou /pr-check\n" "$scope"
fi

exit "$fail"
