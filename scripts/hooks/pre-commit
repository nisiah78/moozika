#!/usr/bin/env bash
#
# Filet de sécurité pour les commits faits À LA MAIN (hors Claude Code).
#
# Il lance le NIVEAU 1 (tests + compilation) des SEULS stacks touchés, pour que
# les trois stacks soient gardés à égalité. Avant, seul PHP l'était : GrumPHP
# s'installe tout seul via son plugin Composer, alors que Python et TS n'avaient
# qu'un contrôle de syntaxe (et Next.js rien du tout).
#
# Le NIVEAU 2 (pylint, eslint, score) reste HORS du hook : pylint prend ~23 s via
# Docker, et un hook lent se contourne au `--no-verify`, donc devient inutile.
# Il vit dans `make gate` / le skill /pr-check.
#
# Coûts mesurés, uniquement si le stack est touché :
#   *.py  → syntaxe + unittest        omr 4,4 s · audiveris 0,04 s
#   *.ts  → tsc --noEmit + tests tsx  5,5 s
#   *.php → GrumPHP (phpstan niv. 8)  1,4 s
#   pire cas, les trois ensemble      ~11 s
#
# PHP passe par GrumPHP et non par gate.py : GrumPHP installe son propre
# .git/hooks/pre-commit, que `core.hooksPath=scripts/hooks` rendrait muet — le
# déléguer ici évite de désactiver silencieusement phpstan/jsonlint/yamllint.
#
# Activation (une fois par clone) :   make hooks
# Contournement volontaire :          git commit --no-verify

set -uo pipefail

RED='\033[0;31m'; YEL='\033[0;33m'; NC='\033[0m'
fail=0

staged() { git diff --cached --name-only --diff-filter=ACMR; }

# --- 1. Index vide --------------------------------------------------------- #
if [ -z "$(staged)" ]; then
    printf "${RED}✗ index vide${NC} — rien à committer (utilise 'git add <fichiers>').\n"
    exit 1
fi

# --- 2. Artefacts qui ne doivent jamais entrer dans un commit -------------- #
while IFS= read -r f; do
    case "$(basename "$f")" in
        _debug_*.ndjson|*.orig|*.rej|*.pyc|*.log)
            printf "${RED}✗ artefact interdit indexé${NC} : %s\n" "$f"
            fail=1
            ;;
    esac
done < <(staged)

# --- 3. Syntaxe Python ----------------------------------------------------- #
# ast.parse et non py_compile : py_compile écrit un .pyc, et le __pycache__ de
# apps/omr-service/app appartient à root (ancien run Docker) → Permission denied.
py=$(staged | grep -E '\.py$' || true)
if [ -n "$py" ]; then
    # shellcheck disable=SC2086
    if ! python3 scripts/quality/syntax_check.py $py 2>/tmp/moozika-hook-py.err; then
        printf "${RED}✗ syntaxe python${NC}\n"
        sed 's/^/    /' /tmp/moozika-hook-py.err
        fail=1
    fi
fi

# --- 4. Niveau 1 des stacks touchés (tests + compilation) ------------------ #
# Délégué à gate.py plutôt que réimplémenté ici : le routage chemin → stack ne
# doit exister qu'à UN endroit. --tier1-only écarte le score (pylint/eslint).
if ! python3 scripts/quality/gate.py --tier1-only; then
    printf "${RED}✗ Niveau 1${NC} — voir le détail ci-dessus (rapport : .git/pr-gate-report.json)\n"
    fail=1
fi

# --- 5. PHP : délégation à GrumPHP ----------------------------------------- #
php=$(staged | grep -E '\.php$' || true)
if [ -n "$php" ]; then
    if [ -x apps/api/vendor/bin/grumphp ]; then
        # Même protocole que le hook natif de GrumPHP : le diff indexé arrive sur
        # stdin, et GRUMPHP_GIT_WORKING_DIR pointe la racine du monorepo.
        GRUMPHP_GIT_WORKING_DIR="$(git rev-parse --show-toplevel)"
        export GRUMPHP_GIT_WORKING_DIR
        DIFF=$(git -c diff.mnemonicprefix=false -c diff.noprefix=false --no-pager \
               diff --raw -r -p -m -M --full-index --no-color --staged | cat)
        if ! (cd apps/api && printf "%s\n" "${DIFF}" \
              | vendor/bin/grumphp git:pre-commit --skip-success-output); then
            printf "${RED}✗ GrumPHP${NC} (phpstan / phpcsfixer / jsonlint / yamllint)\n"
            fail=1
        fi
    elif command -v php >/dev/null 2>&1; then
        # Repli si le vendor n'est pas installé : au moins la syntaxe.
        printf "${YEL}·${NC} GrumPHP absent (composer install) — repli sur php -l\n"
        while IFS= read -r f; do
            [ -f "$f" ] || continue
            if ! php -l "$f" >/tmp/moozika-hook-php.err 2>&1; then
                printf "${RED}✗ php -l${NC} %s\n" "$f"
                sed 's/^/    /' /tmp/moozika-hook-php.err
                fail=1
            fi
        done <<< "$php"
    fi
fi

# --- 6. Rappel : le hook ne remplace pas la porte -------------------------- #
if [ "$fail" -eq 0 ]; then
    if [ -n "$php" ]; then
        scope="Niveau 1 + GrumPHP"
    else
        scope="Niveau 1"
    fi
    printf "${YEL}·${NC} hook OK (%s). Score (pylint/eslint) : ${YEL}make gate${NC} ou /pr-check\n" "$scope"
fi

exit "$fail"
