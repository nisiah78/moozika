# URL du service OMR (côté serveur, utilisée par la route proxy /api/pdf/parse).
# Local  : http://localhost:8000
# Docker : http://omr-service:8000
OMR_SERVICE_URL=http://localhost:8000

# API Symfony (scores / sauvegarde) — exposée au navigateur
NEXT_PUBLIC_API_URL=http://localhost:8080

# Hub Mercure — avancement des transcriptions poussé vers le navigateur.
# Local/Docker : http://localhost:3001/.well-known/mercure
NEXT_PUBLIC_MERCURE_URL=http://localhost:3001/.well-known/mercure
