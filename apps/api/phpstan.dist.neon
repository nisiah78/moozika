# Analyse statique — Niveau 2 de la porte pré-commit (`make lint-php`).
# Niveau 8 : aligné sur apps/api/grumphp.yml et sur `phpstan_level` de
# scripts/quality/thresholds.json — les trois points d'entrée (grumphp, gate.py,
# make lint-php) doivent annoncer le même niveau, sinon ils se contredisent.
# L'extension Symfony est chargée par phpstan/extension-installer.
parameters:
    level: 8
    paths:
        - src
    # Le container n'existe que si le cache dev a été généré (bin/console cache:warmup).
    # Sans lui, phpstan perd la connaissance des services injectés.
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
